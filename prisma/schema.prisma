model Expense {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  projectId            String        @map("project_id") @db.Uuid
  siteId               String?       @map("site_id") @db.Uuid
  categoryId           String        @map("category_id") @db.Uuid
  expenseNumber        String        @map("expense_number") @db.VarChar(50)
  claimantUserId       String        @map("claimant_user_id") @db.Uuid
  expenseDate          DateTime      @map("expense_date") @db.Date
  amount               Decimal       @db.Decimal(15, 2)
  currency             String        @default("INR") @db.VarChar(3)
  description          String
  receiptDocumentUrl   String?       @map("receipt_document_url")
  status               ApprovalState @default(PENDING)
  approvedById         String?       @map("approved_by_id") @db.Uuid
  paymentStatus        String        @default("UNPAID") @map("payment_status") @db.VarChar(50)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site         Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  claimantUser User            @relation("ExpenseClaimant", fields: [claimantUserId], references: [id], onDelete: Restrict)
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, expenseNumber], map: "uq_expenses_company_number")
  @@index([companyId], map: "idx_expenses_company")
  @@index([projectId], map: "idx_expenses_project")
  @@map("expenses")
}

// ------------------------------------------------------------------------------
// DOMAIN 23: INVOICES
// ------------------------------------------------------------------------------

model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  invoiceType     InvoiceType   @map("invoice_type")
  supplierId      String?       @map("supplier_id") @db.Uuid
  contractorId    String?       @map("contractor_id") @db.Uuid
  purchaseOrderId String?       @map("purchase_order_id") @db.Uuid
  invoiceNumber   String        @map("invoice_number") @db.VarChar(100)
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  subtotalAmount  Decimal       @default(0.00) @map("subtotal_amount") @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  retentionAmount Decimal       @default(0.00) @map("retention_amount") @db.Decimal(15, 2)
  totalAmount     Decimal       @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  balanceDue      Decimal       @default(0.00) @map("balance_due") @db.Decimal(15, 2)
  status          ApprovalState @default(PENDING)
  paymentStatus   String        @default("UNPAID") @map("payment_status") @db.VarChar(50)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  contractor    Contractor?     @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([companyId, invoiceType, invoiceNumber], map: "uq_invoices_number")
  @@index([companyId], map: "idx_invoices_company")
  @@index([projectId], map: "idx_invoices_project")
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(14, 4)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 4)
  taxPercent  Decimal  @default(0.00) @map("tax_percent") @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ------------------------------------------------------------------------------
// DOMAIN 22: PAYMENTS
// ------------------------------------------------------------------------------

model Payment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  projectId       String           @map("project_id") @db.Uuid
  invoiceId       String?          @map("invoice_id") @db.Uuid
  paymentNumber   String           @map("payment_number") @db.VarChar(50)
  direction       PaymentDirection
  paymentMode     PaymentMode      @map("payment_mode")
  paymentDate     DateTime         @map("payment_date") @db.Date
  amount          Decimal          @db.Decimal(15, 2)
  currency        String           @default("INR") @db.VarChar(3)
  referenceNumber String?          @map("reference_number") @db.VarChar(100)
  bankName        String?          @map("bank_name") @db.VarChar(150)
  isReconciled    Boolean          @default(false) @map("is_reconciled")
  reconciledAt    DateTime?        @map("reconciled_at") @db.Timestamptz
  recordedById    String           @map("recorded_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy User     @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([companyId, paymentNumber], map: "uq_payments_number")
  @@index([companyId], map: "idx_payments_company")
  @@index([invoiceId], map: "idx_payments_invoice")
  @@map("payments")
}

// ------------------------------------------------------------------------------
// DOMAIN 24: EQUIPMENT & ASSETS
// ------------------------------------------------------------------------------

model Equipment {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  assetCode           String             @map("asset_code") @db.VarChar(50)
  name                String             @db.VarChar(255)
  category            String             @db.VarChar(100)
  make                String?            @db.VarChar(100)
  model               String?            @db.VarChar(100)
  manufacturingYear   Int?               @map("manufacturing_year")
  serialNumber        String?            @map("serial_number") @db.VarChar(100)
  ownership           EquipmentOwnership @default(OWNED)
  supplierId          String?            @map("supplier_id") @db.Uuid
  hourlyRate          Decimal?           @default(0.00) @map("hourly_rate") @db.Decimal(10, 2)
  meterType           MeterType          @default(HOURS) @map("meter_type")
  currentMeterReading Decimal            @default(0.00) @map("current_meter_reading") @db.Decimal(12, 2)
  status              EquipmentStatus    @default(AVAILABLE)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  hiredSupplier        Supplier?               @relation("HiredSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  deployments          EquipmentDeployment[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]
  dprUsages            DprEquipmentUsage[]

  @@unique([companyId, assetCode], map: "uq_equipment_company_code")
  @@index([companyId], map: "idx_equipment_company")
  @@map("equipment")
}

model EquipmentDeployment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  equipmentId       String    @map("equipment_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  siteId            String    @map("site_id") @db.Uuid
  operatorId        String?   @map("operator_id") @db.Uuid
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  startMeterReading Decimal   @map("start_meter_reading") @db.Decimal(12, 2)
  endMeterReading   Decimal?  @map("end_meter_reading") @db.Decimal(12, 2)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  operator  Employee? @relation("EquipmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([equipmentId, siteId, isActive], map: "idx_eq_deployments_lookup")
  @@map("equipment_deployments")
}

// ------------------------------------------------------------------------------
// DOMAIN 25: MAINTENANCE
// ------------------------------------------------------------------------------

model MaintenanceSchedule {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  equipmentId     String          @map("equipment_id") @db.Uuid
  title           String          @db.VarChar(255)
  maintenanceType MaintenanceType @default(PREVENTIVE) @map("maintenance_type")
  intervalHours   Int?            @map("interval_hours")
  intervalDays    Int?            @map("interval_days")
  lastServicedAt  DateTime?       @map("last_serviced_at") @db.Timestamptz
  nextDueReading  Decimal?        @map("next_due_reading") @db.Decimal(12, 2)
  nextDueDate     DateTime?       @map("next_due_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment       Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]

  @@map("maintenance_schedules")
}

model MaintenanceLog {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String          @map("company_id") @db.Uuid
  equipmentId           String          @map("equipment_id") @db.Uuid
  maintenanceScheduleId String?         @map("maintenance_schedule_id") @db.Uuid
  serviceType           MaintenanceType @map("service_type")
  serviceDate           DateTime        @map("service_date") @db.Date
  meterReading          Decimal         @map("meter_reading") @db.Decimal(12, 2)
  cost                  Decimal         @default(0.00) @db.Decimal(15, 2)
  downtimeHours         Decimal         @default(0.00) @map("downtime_hours") @db.Decimal(6, 2)
  performedBy           String          @map("performed_by") @db.VarChar(255)
  description           String
  partsReplaced         String?         @map("parts_replaced")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment           Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceSchedule MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)

  @@index([equipmentId], map: "idx_maint_logs_equipment")
  @@map("maintenance_logs")
}

// ------------------------------------------------------------------------------
// DOMAIN 26: TASKS (WBS & Progress)
// ------------------------------------------------------------------------------

model Task {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  projectId          String       @map("project_id") @db.Uuid
  siteId             String       @map("site_id") @db.Uuid
  parentTaskId       String?      @map("parent_task_id") @db.Uuid
  wbsCode            String       @map("wbs_code") @db.VarChar(100)
  name               String       @db.VarChar(255)
  description        String?
  assignedLeadId     String?      @map("assigned_lead_id") @db.Uuid
  contractorId       String?      @map("contractor_id") @db.Uuid
  plannedStartDate   DateTime     @map("planned_start_date") @db.Date
  plannedEndDate     DateTime     @map("planned_end_date") @db.Date
  actualStartDate    DateTime?    @map("actual_start_date") @db.Date
  actualEndDate      DateTime?    @map("actual_end_date") @db.Date
  progressPercentage Decimal      @default(0.00) @map("progress_percentage") @db.Decimal(5, 2)
  status             TaskStatus   @default(NOT_STARTED)
  priority           TaskPriority @default(MEDIUM)
  estimatedCost      Decimal?     @default(0.00) @map("estimated_cost") @db.Decimal(15, 2)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site                Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parentTask          Task?               @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks            Task[]              @relation("SubTasks")
  assignedLead        Employee?           @relation("TaskLead", fields: [assignedLeadId], references: [id], onDelete: SetNull)
  contractor          Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  dependencies        TaskDependency[]    @relation("TaskDependents")
  precedingTasks      TaskDependency[]    @relation("PredecessorTasks")
  dprWorkItems        DprWorkItem[]
  qualityInspections  QualityInspection[]

  @@unique([projectId, wbsCode], map: "uq_tasks_wbs")
  @@index([companyId], map: "idx_tasks_company")
  @@index([projectId], map: "idx_tasks_project")
  @@index([siteId], map: "idx_tasks_site")
  @@map("tasks")
}

model TaskDependency {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  dependencyType    String   @default("FS") @map("dependency_type") @db.VarChar(10)
  lagDays           Int      @default(0) @map("lag_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  company         Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  task            Task    @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  predecessorTask Task    @relation("PredecessorTasks", fields: [predecessorTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, predecessorTaskId], map: "uq_task_deps")
  @@map("task_dependencies")
}

// ------------------------------------------------------------------------------
// DOMAIN 27: DAILY PROGRESS REPORTS (DPR)
// ------------------------------------------------------------------------------

model DailyProgressReport {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  projectId            String        @map("project_id") @db.Uuid
  siteId               String        @map("site_id") @db.Uuid
  dprNumber            String        @map("dpr_number") @db.VarChar(50)
  reportDate           DateTime      @map("report_date") @db.Date
  weatherSummary       String?       @map("weather_summary") @db.VarChar(100)
  temperatureCelsius   Decimal?      @map("temperature_celsius") @db.Decimal(4, 1)
  engineerInChargeId   String        @map("engineer_in_charge_id") @db.Uuid
  generalSummary       String        @map("general_summary")
  obstaclesChallenges  String?       @map("obstacles_challenges")
  safetyObservations   String?       @map("safety_observations")
  status               ApprovalState @default(PENDING)
  approvedById         String?       @map("approved_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site             Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  engineerInCharge Employee            @relation("DPREngineer", fields: [engineerInChargeId], references: [id], onDelete: Restrict)
  approvedBy       User?               @relation("DPRApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  workItems        DprWorkItem[]
  manpowerCounts   DprManpowerCount[]
  equipmentUsages  DprEquipmentUsage[]

  @@unique([companyId, dprNumber], map: "uq_dpr_company_number")
  @@unique([siteId, reportDate], map: "uq_dpr_site_date")
  @@index([companyId, reportDate], map: "idx_dpr_company_date")
  @@index([siteId, reportDate], map: "idx_dpr_site")
  @@map("daily_progress_reports")
}

model DprWorkItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dprId               String   @map("dpr_id") @db.Uuid
  taskId              String?  @map("task_id") @db.Uuid
  activityDescription String   @map("activity_description")
  locationDetails     String?  @map("location_details") @db.VarChar(255)
  uomId               String?  @map("uom_id") @db.Uuid
  quantityExecuted    Decimal  @map("quantity_executed") @db.Decimal(12, 2)
  remarks             String?

  dpr  DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  task Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uom  UnitOfMeasure?      @relation(fields: [uomId], references: [id], onDelete: SetNull)

  @@map("dpr_work_items")
}

model DprManpowerCount {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dprId        String      @map("dpr_id") @db.Uuid
  contractorId String?     @map("contractor_id") @db.Uuid
  trade        LabourTrade
  headcount    Int
  workingHours Decimal     @default(8.00) @map("working_hours") @db.Decimal(4, 2)

  dpr        DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  contractor Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@map("dpr_manpower_counts")
}

model DprEquipmentUsage {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dprId               String   @map("dpr_id") @db.Uuid
  equipmentId         String   @map("equipment_id") @db.Uuid
  operatingHours      Decimal  @map("operating_hours") @db.Decimal(5, 2)
  idleHours           Decimal  @default(0.00) @map("idle_hours") @db.Decimal(5, 2)
  breakdownHours      Decimal  @default(0.00) @map("breakdown_hours") @db.Decimal(5, 2)
  workDoneDescription String?  @map("work_done_description")

  dpr       DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  equipment Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@map("dpr_equipment_usages")
}

// ------------------------------------------------------------------------------
// DOMAIN 28: SAFETY INCIDENTS (EHS)
// ------------------------------------------------------------------------------

model SafetyIncident {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  projectId             String         @map("project_id") @db.Uuid
  siteId                String         @map("site_id") @db.Uuid
  incidentNumber        String         @map("incident_number") @db.VarChar(50)
  occurredAt            DateTime       @map("occurred_at") @db.Timestamptz
  incidentType          IncidentType   @map("incident_type")
  severity              SeverityLevel
  locationDetails       String         @map("location_details") @db.VarChar(255)
  reportedById          String         @map("reported_by_id") @db.Uuid
  injuredPersonName     String?        @map("injured_person_name") @db.VarChar(150)
  injuredPersonType     AssigneeType?  @map("injured_person_type")
  description           String
  immediateActionsTaken String         @map("immediate_actions_taken")
  rootCauseAnalysis     String?        @map("root_cause_analysis")
  correctiveActionsPlan String?        @map("corrective_actions_plan")
  status                String         @default("OPEN") @db.VarChar(50)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)

  @@unique([companyId, incidentNumber], map: "uq_safety_incidents_number")
  @@index([companyId], map: "idx_safety_company")
  @@index([siteId], map: "idx_safety_site")
  @@map("safety_incidents")
}

// ------------------------------------------------------------------------------
// DOMAIN 29: QUALITY INSPECTIONS (QA/QC)
// ------------------------------------------------------------------------------

model QualityInspectionTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  title          String   @db.VarChar(255)
  category       String   @db.VarChar(100)
  checklistItems Json     @default("[]") @map("checklist_items")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspections QualityInspection[]

  @@map("quality_inspection_templates")
}

model QualityInspection {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                    @map("company_id") @db.Uuid
  projectId        String                    @map("project_id") @db.Uuid
  siteId           String                    @map("site_id") @db.Uuid
  templateId       String?                   @map("template_id") @db.Uuid
  taskId           String?                   @map("task_id") @db.Uuid
  inspectionNumber String                    @map("inspection_number") @db.VarChar(50)
  inspectorId      String                    @map("inspector_id") @db.Uuid
  inspectionDate   DateTime                  @map("inspection_date") @db.Date
  areaOrGrid       String                    @map("area_or_grid") @db.VarChar(255)
  result           InspectionResult          @default(PASSED)
  scorePercentage  Decimal?                  @map("score_percentage") @db.Decimal(5, 2)
  comments         String?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  company   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site      Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  template  QualityInspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  task      Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  inspector Employee                   @relation("QualityInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  defects   QualityDefect[]

  @@unique([companyId, inspectionNumber], map: "uq_quality_inspections_num")
  @@map("quality_inspections")
}

model QualityDefect {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  inspectionId   String?       @map("inspection_id") @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  snagNumber     String        @map("snag_number") @db.VarChar(50)
  title          String        @db.VarChar(255)
  description    String
  severity       SeverityLevel @default(MEDIUM)
  contractorId   String?       @map("contractor_id") @db.Uuid
  dueDate        DateTime      @map("due_date") @db.Date
  photoBeforeUrl String?       @map("photo_before_url")
  photoAfterUrl  String?       @map("photo_after_url")
  status         String        @default("OPEN") @db.VarChar(50)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection QualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contractor Contractor?        @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@index([siteId], map: "idx_defects_site")
  @@map("quality_defects")
}

// ------------------------------------------------------------------------------
// DOMAIN 30: DOCUMENTS
// ------------------------------------------------------------------------------

model Document {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  projectId       String?          @map("project_id") @db.Uuid
  siteId          String?          @map("site_id") @db.Uuid
  category        DocumentCategory @default(OTHER)
  documentCode    String           @map("document_code") @db.VarChar(100)
  title           String           @db.VarChar(255)
  description     String?
  currentVersion  Int              @default(1) @map("current_version")
  storageProvider String           @default("S3") @map("storage_provider") @db.VarChar(50)
  storageKey      String           @map("storage_key")
  fileName        String           @map("file_name") @db.VarChar(255)
  fileSizeBytes   BigInt           @map("file_size_bytes")
  mimeType        String           @map("mime_type") @db.VarChar(100)
  checksumSha256  String           @map("checksum_sha256") @db.VarChar(64)
  uploadedById    String           @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  uploadedBy User              @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  versions   DocumentVersion[]

  @@unique([companyId, documentCode], map: "uq_documents_code")
  @@index([projectId], map: "idx_documents_project")
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  storageKey     String   @map("storage_key")
  fileName       String   @map("file_name") @db.VarChar(255)
  fileSizeBytes  BigInt   @map("file_size_bytes")
  checksumSha256 String   @map("checksum_sha256") @db.VarChar(64)
  changeSummary  String?  @map("change_summary")
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber], map: "uq_doc_version")
  @@map("document_versions")
}

// ------------------------------------------------------------------------------
// DOMAIN 31: NOTIFICATIONS
// ------------------------------------------------------------------------------

model Notification {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String              @map("company_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  title      String              @db.VarChar(255)
  message    String
  channel    NotificationChannel @default(IN_APP)
  entityType String?             @map("entity_type") @db.VarChar(100)
  entityId   String?             @map("entity_id") @db.Uuid
  isRead     Boolean             @default(false) @map("is_read")
  readAt     DateTime?           @map("read_at") @db.Timestamptz
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_unread")
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// DOMAIN 32: APPROVAL WORKFLOWS ENGINE
// ------------------------------------------------------------------------------

model ApprovalWorkflow {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(150)
  targetEntity String   @map("target_entity") @db.VarChar(100)
  totalSteps   Int      @default(1) @map("total_steps")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@unique([companyId, code], map: "uq_approval_workflows_code")
  @@map("approval_workflows")
}

model ApprovalStep {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  stepNumber     Int      @map("step_number")
  stepName       String   @map("step_name") @db.VarChar(100)
  roleId         String?  @map("role_id") @db.Uuid
  specificUserId String?  @map("specific_user_id") @db.Uuid
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  role         Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  specificUser User?            @relation("StepAssignee", fields: [specificUserId], references: [id], onDelete: SetNull)

  @@unique([workflowId, stepNumber], map: "uq_approval_workflow_step")
  @@map("approval_steps")
}

model ApprovalInstance {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  workflowId  String        @map("workflow_id") @db.Uuid
  entityType  String        @map("entity_type") @db.VarChar(100)
  entityId    String        @map("entity_id") @db.Uuid
  currentStep Int           @default(1) @map("current_step")
  status      ApprovalState @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow   ApprovalWorkflow    @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  actionLogs ApprovalActionLog[]

  @@map("approval_instances")
}

model ApprovalActionLog {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String        @map("instance_id") @db.Uuid
  stepNumber Int           @map("step_number")
  actorId    String        @map("actor_id") @db.Uuid
  action     ApprovalState
  comments   String?
  actionAt   DateTime      @default(now()) @map("action_at") @db.Timestamptz

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User             @relation("ActionLogger", fields: [actorId], references: [id], onDelete: Restrict)

  @@map("approval_action_logs")
}

// ------------------------------------------------------------------------------
// DOMAIN 33: AUDIT LOGS (Immutable System-Wide Forensic Trail)
// ------------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(50)
  tableName     String   @map("table_name") @db.VarChar(100)
  recordId      String?  @map("record_id") @db.Uuid
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  changedFields String[] @map("changed_fields")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUser User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt], map: "idx_audit_logs_company_time")
  @@index([tableName, recordId], map: "idx_audit_logs_table_record")
  @@map("audit_logs")
}
