  grossEarnings     Decimal      @default(0.00) @map("gross_earnings") @db.Decimal(15, 2)
  pfDeduction       Decimal      @default(0.00) @map("pf_deduction") @db.Decimal(15, 2)
  esiDeduction      Decimal      @default(0.00) @map("esi_deduction") @db.Decimal(15, 2)
