// ==============================================================================
// CONSTRUCT360 ENTERPRISE PRISMA ORM SCHEMA
// Architecture: Multi-Tenant Enterprise Construction Operations & ERP
// Engine: PostgreSQL 15+ with PostGIS 3+
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_NOTICE
  TERMINATED
  RESIGNED

  @@map("employee_status")
}

enum ContractorType {
  GENERAL
  CIVIL_WORKS
  ELECTRICAL
  PLUMBING
  HVAC
  REBAR
  MASONRY
  LABOUR_SUPPLY

  @@map("contractor_type")
}

enum LabourSkillLevel {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED

  @@map("labour_skill_level")
}

enum LabourTrade {
  MASON
  CARPENTER
  BAR_BENDER
  ELECTRICIAN
  PLUMBER
  PAINTER
  WELDER
  SCAFFOLDER
  EQUIPMENT_OPERATOR
  SURVEY_HELPER
  GENERAL_HELPER
  OTHER

  @@map("labour_trade")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

enum SiteStatus {
  PREPARATION
  ACTIVE_CONSTRUCTION
  FINISHING
  HANDOVER
  MAINTENANCE
  CLOSED

  @@map("site_status")
}

enum GeofenceType {
  CIRCULAR
  POLYGON

  @@map("geofence_type")
}

enum AssigneeType {
  EMPLOYEE
  LABOURER
  CONTRACTOR

  @@map("assignee_type")
}

enum AttendanceSessionStatus {
  PRESENT
  HALF_DAY
  ABSENT
  OVERTIME
  ON_LEAVE
  REGULARIZED

  @@map("attendance_session_status")
}

enum AttendanceVerificationStatus {
  VERIFIED
  FLAGGED
  REJECTED
  REQUIRES_APPROVAL

  @@map("attendance_verification_status")
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_state")
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
  SITE_TRANSFER

  @@map("attendance_event_type")
}

enum PunchSource {
  MOBILE_APP
  KIOSK_FACIAL
  BIOMETRIC_DEVICE
  SUPERVISOR_PORTAL
  AUTO_CHECKOUT

  @@map("punch_source")
}

enum VerificationMethod {
  GEOFENCE_ONLY
  FACE_RECOGNITION
  BIOMETRIC_FINGERPRINT
  QR_CODE_SCAN
  SUPERVISOR_OVERRIDE

  @@map("verification_method")
}

enum CorrectionType {
  MISSING_CLOCK_IN
  MISSING_CLOCK_OUT
  WRONG_HOURS
  GEOFENCE_BYPASS_REQUEST
  DUTY_TRAVEL

  @@map("correction_type")
}

enum PayrollCycle {
  WEEKLY
  FORTNIGHTLY
  MONTHLY

  @@map("payroll_cycle")
}

enum WarehouseType {
  CENTRAL
  SITE_STORE
  LAYDOWN_YARD
  SCRAP_YARD
  TRANSIT

  @@map("warehouse_type")
}

enum StockTransactionType {
  RECEIPT_PO
  ISSUE_PROJECT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_SUPPLIER
  RETURN_SITE
  WASTAGE_DAMAGE
  ADJUSTMENT_PHYSICAL

  @@map("stock_transaction_type")
}

enum PoStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED

  @@map("po_status")
}

enum GrnStatus {
  DRAFT
  INSPECTED
  ACCEPTED
  REJECTED

  @@map("grn_status")
}

enum InvoiceType {
  CLIENT_BILLING
  VENDOR_INVOICE
  SUBCONTRACTOR_BILL

  @@map("invoice_type")
}

enum PaymentMode {
  BANK_TRANSFER_NEFT
  RTGS
  IMPS
  CHEQUE
  UPI
  CASH
  CREDIT_CARD

  @@map("payment_mode")
}

enum PaymentDirection {
  INCOMING
  OUTGOING

  @@map("payment_direction")
}

enum EquipmentOwnership {
  OWNED
  HIRED
  LEASED

  @@map("equipment_ownership")
}

enum EquipmentStatus {
  AVAILABLE
  DEPLOYED
  UNDER_MAINTENANCE
  BREAKDOWN
  DECOMMISSIONED

  @@map("equipment_status")
}

enum MeterType {
  HOURS
  KILOMETERS

  @@map("meter_type")
}

enum MaintenanceType {
  PREVENTIVE
  BREAKDOWN
  INSPECTION

  @@map("maintenance_type")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("task_priority")
}

enum IncidentType {
  NEAR_MISS
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME_INJURY
  FATALITY
  PROPERTY_DAMAGE
  ENVIRONMENTAL

  @@map("incident_type")
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("severity_level")
}

enum InspectionResult {
  PASSED
  FAILED
  PASSED_WITH_CONDITIONS

  @@map("inspection_result")
}

enum DocumentCategory {
  ARCHITECTURAL_DRAWING
  STRUCTURAL_DRAWING
  BIM_MODEL
  CONTRACT
  PERMIT
  SAFETY_CERTIFICATE
  INVOICE_COPY
  OTHER

  @@map("document_category")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH

  @@map("notification_channel")
}

// ------------------------------------------------------------------------------
// DOMAIN 1: COMPANIES & BRANCHES
// ------------------------------------------------------------------------------

model Company {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String   @unique @db.VarChar(50)
  legalName          String   @map("legal_name") @db.VarChar(255)
  tradeName          String?  @map("trade_name") @db.VarChar(255)
  taxId              String?  @map("tax_id") @db.VarChar(50)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  currency           String   @default("INR") @db.VarChar(3)
  email              String   @db.VarChar(255)
  phone              String?  @db.VarChar(30)
  website            String?  @db.VarChar(255)
  logoUrl            String?  @map("logo_url")
  timezone           String   @default("Asia/Kolkata") @db.VarChar(50)
  settings           Json     @default("{}")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  branches             Branch[]
  userMemberships      UserCompanyMembership[]
  roles                Role[]
  userRoles            UserRole[]
  departments          Department[]
  designations         Designation[]
  employees            Employee[]
  contractors          Contractor[]
  labourers            Labourer[]
  projects             Project[]
  sites                Site[]
  siteGeofences        SiteGeofence[]
  siteAssignments      SiteAssignment[]
  shifts               Shift[]
  shiftRosters         ShiftRoster[]
  attendanceSessions   AttendanceSession[]
  attendanceEvents     AttendanceEvent[]
  locationEvents       LocationEvent[]
  attendanceCorrections AttendanceCorrection[]
  attendanceApprovals  AttendanceApproval[]
  leaveTypes           LeaveType[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  salaryStructures     SalaryStructure[]
  payrollRuns          PayrollRun[]
  payslips             Payslip[]
  unitsOfMeasure       UnitOfMeasure[]
  materialCategories   MaterialCategory[]
  materials            Material[]
  warehouses           Warehouse[]
  stockTransactions    StockTransaction[]
  stockBalances        StockBalance[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  invoices             Invoice[]
  payments             Payment[]
  equipment            Equipment[]
  equipmentDeployments EquipmentDeployment[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]
  tasks                Task[]
  taskDependencies     TaskDependency[]
  dprs                 DailyProgressReport[]
  safetyIncidents      SafetyIncident[]
  inspectionTemplates  QualityInspectionTemplate[]
  qualityInspections   QualityInspection[]
  qualityDefects       QualityDefect[]
  documents            Document[]
  notifications        Notification[]
  approvalWorkflows    ApprovalWorkflow[]
  approvalInstances    ApprovalInstance[]
  auditLogs            AuditLog[]

  @@map("companies")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  email          String?  @db.VarChar(255)
  phone          String?  @db.VarChar(30)
  addressLine1   String   @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String   @db.VarChar(100)
  state          String   @db.VarChar(100)
  country        String   @default("India") @db.VarChar(100)
  postalCode     String   @map("postal_code") @db.VarChar(20)
  isHeadquarters Boolean  @default(false) @map("is_headquarters")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userMemberships UserCompanyMembership[]
  employees       Employee[]
  projects        Project[]

  @@unique([companyId, code], map: "uq_branches_company_code")
  @@index([companyId], map: "idx_branches_company")
  @@map("branches")
}

// ------------------------------------------------------------------------------
// DOMAIN 2: USERS & AUTHENTICATION
// ------------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  phoneNumber     String?   @unique @map("phone_number") @db.VarChar(30)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret") @db.VarChar(255)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(45)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships           UserCompanyMembership[]
  sessions              UserSession[]
  userRoles             UserRole[]
  employeeProfile       Employee?
  approvedSessions      AttendanceSession[]     @relation("ApprovedSessions")
  requestedCorrections  AttendanceCorrection[]  @relation("CorrectionRequester")
  reviewedCorrections   AttendanceCorrection[]  @relation("CorrectionReviewer")
  attendanceApprovals   AttendanceApproval[]    @relation("AttendanceApprover")
  approvedLeaves        LeaveRequest[]          @relation("LeaveApprover")
  processedPayrollRuns  PayrollRun[]            @relation("PayrollProcessor")
  transactedStock       StockTransaction[]      @relation("StockTransactor")
  createdPOs            PurchaseOrder[]         @relation("POCreator")
  approvedPOs           PurchaseOrder[]         @relation("POApprover")
  receivedGRNs          PurchaseReceipt[]       @relation("GRNReceiver")
  claimedExpenses       Expense[]               @relation("ExpenseClaimant")
  approvedExpenses      Expense[]               @relation("ExpenseApprover")
  recordedPayments      Payment[]               @relation("PaymentRecorder")
  approvedDPRs          DailyProgressReport[]   @relation("DPRApprover")
  reportedIncidents     SafetyIncident[]        @relation("IncidentReporter")
  uploadedDocuments     Document[]              @relation("DocUploader")
  uploadedVersions      DocumentVersion[]       @relation("VersionUploader")
  notifications         Notification[]
  assignedApprovalSteps ApprovalStep[]          @relation("StepAssignee")
  approvalActionLogs    ApprovalActionLog[]     @relation("ActionLogger")
  auditLogs             AuditLog[]              @relation("AuditActor")

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserCompanyMembership {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  defaultBranchId String?  @map("default_branch_id") @db.Uuid
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultBranch Branch?  @relation(fields: [defaultBranchId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId], map: "uq_user_company")
  @@index([userId], map: "idx_user_memberships_user")
  @@index([companyId], map: "idx_user_memberships_company")
  @@map("user_company_memberships")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent")
  deviceId         String?   @map("device_id") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user")
  @@index([refreshTokenHash], map: "idx_user_sessions_token")
  @@map("user_sessions")
}

// ------------------------------------------------------------------------------
// DOMAIN 3: ROLES & PERMISSIONS
// ------------------------------------------------------------------------------

model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?  @map("company_id") @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @db.VarChar(100)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]
  approvalSteps ApprovalStep[]

  @@unique([companyId, slug], map: "uq_roles_company_slug")
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  code        String   @unique @db.VarChar(150)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, roleId, projectId], map: "uq_user_role_assignment")
  @@index([companyId, userId], map: "idx_user_roles_lookup")
  @@map("user_roles")
}

// ------------------------------------------------------------------------------
// DOMAIN 4: EMPLOYEES
// ------------------------------------------------------------------------------

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([companyId, code], map: "uq_departments_company_code")
  @@map("departments")
}

model Designation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  title     String   @db.VarChar(100)
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([companyId, title], map: "uq_designations_company_title")
  @@map("designations")
}

model Employee {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  branchId              String?        @map("branch_id") @db.Uuid
  userId                String?        @unique @map("user_id") @db.Uuid
  departmentId          String?        @map("department_id") @db.Uuid
  designationId         String?        @map("designation_id") @db.Uuid
  reportingManagerId    String?        @map("reporting_manager_id") @db.Uuid
  employeeCode          String         @map("employee_code") @db.VarChar(50)
  firstName             String         @map("first_name") @db.VarChar(100)
  lastName              String         @map("last_name") @db.VarChar(100)
  email                 String?        @db.VarChar(255)
  phone                 String         @db.VarChar(30)
  emergencyContactName  String?        @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?        @map("emergency_contact_phone") @db.VarChar(30)
  dateOfBirth           DateTime?      @map("date_of_birth") @db.Date
  gender                String?        @db.VarChar(20)
  joiningDate           DateTime       @map("joining_date") @db.Date
  exitDate              DateTime?      @map("exit_date") @db.Date
  status                EmployeeStatus @default(ACTIVE)
  photoUrl              String?        @map("photo_url")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation          Designation?          @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager     Employee?             @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates         Employee[]            @relation("ManagerSubordinates")
  engineeredSites      Site[]                @relation("SiteEngineer")
  siteAssignments      SiteAssignment[]
  shiftRosters         ShiftRoster[]
  attendanceSessions   AttendanceSession[]
  attendanceEvents     AttendanceEvent[]
  locationEvents       LocationEvent[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  salaryStructure      SalaryStructure?
  payslips             Payslip[]
  managedWarehouses    Warehouse[]           @relation("Storekeeper")
  operatedDeployments  EquipmentDeployment[] @relation("EquipmentOperator")
  leadTasks            Task[]                @relation("TaskLead")
  authoredDPRs         DailyProgressReport[] @relation("DPREngineer")
  conductedInspections QualityInspection[]   @relation("QualityInspector")

  @@unique([companyId, employeeCode], map: "uq_employees_company_code")
  @@index([companyId], map: "idx_employees_company")
  @@index([companyId, status], map: "idx_employees_status")
  @@map("employees")
}

// ------------------------------------------------------------------------------
// DOMAIN 5: CONTRACTORS
// ------------------------------------------------------------------------------

model Contractor {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  contractorCode String         @map("contractor_code") @db.VarChar(50)
  businessName   String         @map("business_name") @db.VarChar(255)
  contractorType ContractorType @default(LABOUR_SUPPLY) @map("contractor_type")
  contactPerson  String         @map("contact_person") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String         @db.VarChar(30)
  taxId          String?        @map("tax_id") @db.VarChar(50)
  panNumber      String?        @map("pan_number") @db.VarChar(50)
  address        String?
  rating         Decimal?       @default(5.00) @db.Decimal(3, 2)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  labourers        Labourer[]
  siteAssignments  SiteAssignment[]
  invoices         Invoice[]
  assignedTasks    Task[]
  dprManpower      DprManpowerCount[]
  assignedDefects  QualityDefect[]

  @@unique([companyId, contractorCode], map: "uq_contractors_company_code")
  @@index([companyId], map: "idx_contractors_company")
  @@map("contractors")
}

// ------------------------------------------------------------------------------
// DOMAIN 6: LABOURERS
// ------------------------------------------------------------------------------

model Labourer {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  contractorId       String?          @map("contractor_id") @db.Uuid
  labourerCode       String           @map("labourer_code") @db.VarChar(50)
  firstName          String           @map("first_name") @db.VarChar(100)
  lastName           String           @map("last_name") @db.VarChar(100)
  phone              String?          @db.VarChar(30)
  skillLevel         LabourSkillLevel @default(UNSKILLED) @map("skill_level")
  primaryTrade       LabourTrade      @default(GENERAL_HELPER) @map("primary_trade")
  dailyWageRate      Decimal          @default(0.00) @map("daily_wage_rate") @db.Decimal(10, 2)
  overtimeHourlyRate Decimal          @default(0.00) @map("overtime_hourly_rate") @db.Decimal(10, 2)
  idProofType        String?          @map("id_proof_type") @db.VarChar(50)
  idProofNumber      String?          @map("id_proof_number") @db.VarChar(100)
  emergencyPhone     String?          @map("emergency_phone") @db.VarChar(30)
