// ------------------------------------------------------------------------------
// DOMAIN 17: STOCK TRANSACTIONS (Auditable Double-Entry Ledger)
// ------------------------------------------------------------------------------

model StockTransaction {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String               @map("company_id") @db.Uuid
  transactionNumber      String               @map("transaction_number") @db.VarChar(50)
  transactionType        StockTransactionType @map("transaction_type")
  materialId             String               @map("material_id") @db.Uuid
  sourceWarehouseId      String?              @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String?              @map("destination_warehouse_id") @db.Uuid
  projectId              String?              @map("project_id") @db.Uuid
  siteId                 String?              @map("site_id") @db.Uuid
  quantity               Decimal              @db.Decimal(14, 4)
  unitRate               Decimal              @default(0.0000) @map("unit_rate") @db.Decimal(15, 4)
  totalValue             Decimal              @default(0.00) @map("total_value") @db.Decimal(15, 2)
  batchNumber            String?              @map("batch_number") @db.VarChar(100)
  referenceType          String               @map("reference_type") @db.VarChar(50)
  referenceId            String?              @map("reference_id") @db.Uuid
  transactedById         String               @map("transacted_by_id") @db.Uuid
  transactedAt           DateTime             @default(now()) @map("transacted_at") @db.Timestamptz
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz

  company              Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  material             Material   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  sourceWarehouse      Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse? @relation("DestWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  project              Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  site                 Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  transactedBy         User       @relation("StockTransactor", fields: [transactedById], references: [id], onDelete: Restrict)

  @@unique([companyId, transactionNumber], map: "uq_stock_tx_number")
  @@index([companyId, transactedAt], map: "idx_stock_tx_company_time")
  @@index([materialId], map: "idx_stock_tx_material")
  @@index([sourceWarehouseId], map: "idx_stock_tx_src_wh")
  @@index([destinationWarehouseId], map: "idx_stock_tx_dst_wh")
  @@map("stock_transactions")
}

model StockBalance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  materialId        String    @map("material_id") @db.Uuid
  quantityOnHand    Decimal   @default(0.0000) @map("quantity_on_hand") @db.Decimal(14, 4)
  allocatedQuantity Decimal   @default(0.0000) @map("allocated_quantity") @db.Decimal(14, 4)
  averageUnitCost   Decimal   @default(0.0000) @map("average_unit_cost") @db.Decimal(15, 4)
  lastTransactionAt DateTime? @map("last_transaction_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([companyId, warehouseId, materialId], map: "uq_stock_balances")
  @@index([companyId, warehouseId, materialId], map: "idx_stock_balances_lookup")
  @@map("stock_balances")
}

