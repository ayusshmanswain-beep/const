// DOMAIN 11: ATTENDANCE (Precision Spatial & Rollup Architecture)
// ------------------------------------------------------------------------------

model AttendanceSession {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String                       @map("company_id") @db.Uuid
  projectId            String                       @map("project_id") @db.Uuid
  siteId               String                       @map("site_id") @db.Uuid
  shiftId              String?                      @map("shift_id") @db.Uuid
  workerType           AssigneeType                 @map("worker_type")
  employeeId           String?                      @map("employee_id") @db.Uuid
  labourerId           String?                      @map("labourer_id") @db.Uuid
  sessionDate          DateTime                     @map("session_date") @db.Date
  firstClockIn         DateTime?                    @map("first_clock_in") @db.Timestamptz
  lastClockOut         DateTime?                    @map("last_clock_out") @db.Timestamptz
  totalDurationMinutes Int                          @default(0) @map("total_duration_minutes")
  regularMinutes       Int                          @default(0) @map("regular_minutes")
  overtimeMinutes      Int                          @default(0) @map("overtime_minutes")
  breakDurationMinutes Int                          @default(0) @map("break_duration_minutes")
  status               AttendanceSessionStatus      @default(ABSENT)
  verificationStatus   AttendanceVerificationStatus @default(VERIFIED) @map("verification_status")
  approvalStatus       ApprovalState                @default(PENDING) @map("approval_status")
  approvedById         String?                      @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?                    @map("approved_at") @db.Timestamptz
  remarks              String?
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site         Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shift        Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  employee     Employee?              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  labourer     Labourer?              @relation(fields: [labourerId], references: [id], onDelete: Cascade)
  approvedBy   User?                  @relation("ApprovedSessions", fields: [approvedById], references: [id], onDelete: SetNull)
  events       AttendanceEvent[]
  corrections  AttendanceCorrection[]
  approvals    AttendanceApproval[]

  @@unique([companyId, sessionDate, workerType, employeeId, labourerId], map: "uq_attendance_session")
  @@index([companyId, sessionDate], map: "idx_att_sessions_company_date")
  @@index([siteId, sessionDate], map: "idx_att_sessions_site")
  @@index([employeeId, sessionDate], map: "idx_att_sessions_employee")
  @@index([labourerId, sessionDate], map: "idx_att_sessions_labourer")
  @@map("attendance_sessions")
}

model AttendanceEvent {
  id                             String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                      String                                @map("company_id") @db.Uuid
  sessionId                      String                                @map("session_id") @db.Uuid
  projectId                      String                                @map("project_id") @db.Uuid
  siteId                         String                                @map("site_id") @db.Uuid
  geofenceId                     String?                               @map("geofence_id") @db.Uuid
  workerType                     AssigneeType                          @map("worker_type")
  employeeId                     String?                               @map("employee_id") @db.Uuid
  labourerId                     String?                               @map("labourer_id") @db.Uuid
  eventType                      AttendanceEventType                   @map("event_type")
  eventTimestamp                 DateTime                              @map("event_timestamp") @db.Timestamptz
  serverTimestamp                DateTime                              @default(now()) @map("server_timestamp") @db.Timestamptz
  source                         PunchSource                           @default(MOBILE_APP)
  verificationMethod             VerificationMethod                    @default(GEOFENCE_ONLY) @map("verification_method")
  verificationResult             String                                @map("verification_result") @db.VarChar(50)
  latitude                       Decimal                               @db.Decimal(10, 8)
  longitude                      Decimal                               @db.Decimal(11, 8)
  coordinates                    Unsupported("geography(Point, 4326)")? @map("coordinates")
  gpsAccuracyMeters              Decimal                               @map("gps_accuracy_meters") @db.Decimal(8, 2)
  calculatedDistanceMeters       Decimal                               @map("calculated_distance_meters") @db.Decimal(10, 2)
  configuredRadiusSnapshotMeters Decimal                               @map("configured_radius_snapshot_meters") @db.Decimal(10, 2)
  isInsideGeofence               Boolean                               @default(false) @map("is_inside_geofence")
  isMockLocation                 Boolean                               @default(false) @map("is_mock_location")
  photoUrl                       String?                               @map("photo_url")
