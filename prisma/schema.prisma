  @@index([sessionId], map: "idx_att_events_session")
  @@index([companyId, eventTimestamp], map: "idx_att_events_company_time")
  @@index([siteId, eventTimestamp], map: "idx_att_events_site")
  @@map("attendance_events")
}

model LocationEvent {
